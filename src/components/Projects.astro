---
// Projects Grid Section Component
const projects = [
  {
    title: "Starlight Engine",
    description: "A real-time data visualization engine for tracking interstellar anomalies.",
    image: "/images/projects/dunkin.png",
    tags: ["REACT", "NODE", "THREE.JS"]
  },
  {
    title: "Beacon Sentinel",
    description: "Automated lighthouse monitoring platform with predictive maintenance AI.",
    image: "/images/projects/de_gaza_al_mundo.png",
    tags: ["TYPESCRIPT", "DOCKER"]
  },
  {
    title: "Nebula Cartography",
    description: "Open-source celestial mapping tool for amateur astronomers and sailors.",
    image: "/images/projects/bikephy.png",
    tags: ["VUE", "SUPABASE"]
  }
];
---

<section class="py-24 bg-black/40" id="projects">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-end justify-between mb-12">
      <div>
        <h2 class="text-3xl font-bold tracking-tight">Active Missions</h2>
        <p class="text-slate-400 mt-2">Latest projects from the starship archives.</p>
      </div>
      <button class="hidden md:block text-primary font-bold text-sm hover:underline">VIEW ALL LOGS</button>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => (
        <div class="group hyperspace-hover rounded-xl overflow-hidden glass-card">
          <div class="aspect-video relative overflow-hidden">
            <img class="w-full h-full object-cover" src={project.image} alt={project.title} />
            <div class="absolute inset-0 bg-primary/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <span class="px-6 py-2 bg-white text-black font-bold rounded-full text-sm">VIEW MISSION</span>
            </div>
          </div>
          <div class="p-6">
            <div class="flex gap-2 mb-3">
              {project.tags.map((tag) => (
                <span class="px-2 py-0.5 bg-white/5 text-[10px] font-bold rounded">{tag}</span>
              ))}
            </div>
            <h3 class="text-xl font-bold mb-2">{project.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">{project.description}</p>
            <div class="flex justify-between items-center">
              <a class="text-xs font-bold text-primary hover:text-accent flex items-center gap-1" href="#">
                <span class="material-symbols-outlined text-sm">code</span> SOURCE
              </a>
              <a class="text-xs font-bold text-slate-400 hover:text-white flex items-center gap-1" href="#">
                <span class="material-symbols-outlined text-sm">open_in_new</span> LIVE PREVIEW
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

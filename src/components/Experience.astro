---
// Experience Timeline Section Component
---

<section class="py-24 bg-black/20" id="experience">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-bold tracking-tight mb-16 text-center">Experience Timeline</h2>
    
    <div class="relative">
      <!-- Lightsaber Timeline Line -->
      <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-[2px] bg-primary lightsaber-line -translate-x-1/2"></div>
      
      <div class="space-y-12">
        <!-- Item 1 -->
        <div class="relative flex flex-col md:flex-row items-center justify-between">
          <div class="w-full md:w-[45%] mb-4 md:mb-0">
            <div class="p-6 glass-card rounded-xl text-right hidden md:block">
              <span class="text-primary font-bold text-sm">2022 — PRESENT</span>
              <h3 class="text-xl font-bold mt-1">Lead Systems Architect</h3>
              <p class="text-slate-400 text-sm mt-2">Orbital Dynamics Solutions</p>
            </div>
            <div class="p-6 glass-card rounded-xl md:hidden">
              <span class="text-primary font-bold text-sm">2022 — PRESENT</span>
              <h3 class="text-xl font-bold mt-1">Lead Systems Architect</h3>
              <p class="text-slate-400 text-sm mt-2">Managing large-scale microservices and cloud infrastructure for cosmic data processing.</p>
            </div>
          </div>
          <div class="absolute left-0 md:left-1/2 size-4 bg-primary rounded-full -translate-x-1/2 z-10 border-4 border-bg-dark shadow-[0_0_10px_#135bec]"></div>
          <div class="w-full md:w-[45%] md:pl-10 hidden md:block">
            <p class="text-slate-400 text-sm">Managing large-scale microservices and cloud infrastructure for cosmic data processing across multiple planetary nodes.</p>
          </div>
        </div>
        
        <!-- Item 2 -->
        <div class="relative flex flex-col md:flex-row-reverse items-center justify-between">
          <div class="w-full md:w-[45%] mb-4 md:mb-0">
            <div class="p-6 glass-card rounded-xl text-left hidden md:block">
              <span class="text-primary font-bold text-sm">2019 — 2022</span>
              <h3 class="text-xl font-bold mt-1">Senior Fullstack Navigator</h3>
              <p class="text-slate-400 text-sm mt-2">Oceanic Digital Ports</p>
            </div>
            <div class="p-6 glass-card rounded-xl md:hidden">
              <span class="text-primary font-bold text-sm">2019 — 2022</span>
              <h3 class="text-xl font-bold mt-1">Senior Fullstack Navigator</h3>
              <p class="text-slate-400 text-sm mt-2">Spearheaded the development of real-time maritime tracking systems and lighthouse monitoring APIs.</p>
            </div>
          </div>
          <div class="absolute left-0 md:left-1/2 size-4 bg-primary rounded-full -translate-x-1/2 z-10 border-4 border-bg-dark shadow-[0_0_10px_#135bec]"></div>
          <div class="w-full md:w-[45%] md:pr-10 hidden md:block text-right">
            <p class="text-slate-400 text-sm">Spearheaded the development of real-time maritime tracking systems and lighthouse monitoring APIs with 99.9% uptime.</p>
          </div>
        </div>
        
        <!-- Item 3 -->
        <div class="relative flex flex-col md:flex-row items-center justify-between">
          <div class="w-full md:w-[45%] mb-4 md:mb-0">
            <div class="p-6 glass-card rounded-xl text-right hidden md:block">
              <span class="text-primary font-bold text-sm">2017 — 2019</span>
              <h3 class="text-xl font-bold mt-1">Frontend Cadet</h3>
              <p class="text-slate-400 text-sm mt-2">Nebula Web Studios</p>
            </div>
            <div class="p-6 glass-card rounded-xl md:hidden">
              <span class="text-primary font-bold text-sm">2017 — 2019</span>
              <h3 class="text-xl font-bold mt-1">Frontend Cadet</h3>
              <p class="text-slate-400 text-sm mt-2">Built interactive UI components using React and D3.js for astronomical data visualization.</p>
            </div>
          </div>
          <div class="absolute left-0 md:left-1/2 size-4 bg-primary rounded-full -translate-x-1/2 z-10 border-4 border-bg-dark shadow-[0_0_10px_#135bec]"></div>
          <div class="w-full md:w-[45%] md:pl-10 hidden md:block">
            <p class="text-slate-400 text-sm">Built interactive UI components using React and D3.js for astronomical data visualization and telemetry dashboards.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
